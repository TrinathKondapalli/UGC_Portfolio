---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { whatsappUrl } from '../config';
---
<Base title="Request sent — Tzinr">
  <Nav />
  <main id="main">
    <section class="thanks">
      <div class="container thanks-inner">
        <h1 class="heading">Request sent. We'll reply on WhatsApp.</h1>
        <p class="lead">
          Thanks for sharing your product. We take a limited number of free samples each week and
          will get back to you shortly.
        </p>
        <div class="thanks-actions">
          <a class="btn btn-primary" href={whatsappUrl()} target="_blank" rel="noopener">
            Or message us now
          </a>
          <a class="btn btn-ghost" href="/">Back to home</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .thanks { padding-block: var(--sp-8); }
  .thanks-inner {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    max-width: 640px;
  }
  .thanks-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin-top: var(--sp-3);
  }
</style>

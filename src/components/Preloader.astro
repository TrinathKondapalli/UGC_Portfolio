---
---
<div class="preloader" id="preloader" aria-hidden="true">
  <div class="preloader-content">
    <div class="preloader-brand-mask">
      <div class="preloader-brand">Tzinr</div>
    </div>
    <div class="preloader-bottom">
      <div class="preloader-counter" id="preloader-counter">0%</div>
      <div class="preloader-bar-track">
        <div class="preloader-bar-fill" id="preloader-bar-fill"></div>
      </div>
    </div>
  </div>
</div>

<style>
  .preloader {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: var(--ink);
    color: var(--chalk);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    will-change: transform;
  }
  .preloader-content {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    position: relative;
  }
  .preloader-brand-mask {
    overflow: hidden;
  }
  .preloader-brand {
    font-family: var(--font-display);
    font-size: clamp(4rem, 12vw, 10rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    transform: translateY(110%);
    color: var(--chalk);
    will-change: transform;
  }
  .preloader-bottom {
    position: absolute;
    bottom: var(--sp-6);
    left: var(--side-padding);
    right: var(--side-padding);
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }
  @media (min-width: 900px) {
    .preloader-bottom {
      bottom: var(--sp-7);
    }
  }
  .preloader-counter {
    font-family: var(--font-body);
    font-size: var(--text-button);
    font-weight: 500;
    color: var(--smoke);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .preloader-bar-track {
    width: 100%;
    height: 2px;
    background: rgba(250, 250, 247, 0.1);
    position: relative;
    overflow: hidden;
  }
  .preloader-bar-fill {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 100%;
    background: var(--rec);
    transform-origin: left;
    transform: scaleX(0);
    will-change: transform;
  }
</style>

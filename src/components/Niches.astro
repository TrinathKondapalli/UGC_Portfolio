---
import type { CollectionEntry } from 'astro:content';

interface Props {
  items: CollectionEntry<'work'>[];
}
const { items } = Astro.props;

const panels = [
  {
    key: 'Beauty',
    title: 'Beauty and personal care',
    points: ['True-to-shade swatches', 'Texture and application close-ups', 'Routine moments'],
  },
  {
    key: 'Fashion',
    title: 'Fashion and accessories',
    points: ['Jewellery macro shots in window light', 'Real size on the body', 'Festive styling'],
  },
  {
    key: 'Fitness',
    title: 'Lifestyle and fitness',
    points: ['The product doing its job', 'Scale in the hand', 'Home and on-the-go settings'],
  },
] as const;

const itemMap: Record<string, string> = {
  Fashion: "Yellow Chimes oxidised jhumkas",
  Fitness: "Boldfit EVA yoga mat"
};
const getForNiche = (niche: string) => items.find((i) => i.data.title === itemMap[niche]);
---
<section class="niches" id="niches-pin-container">
  <div class="niches-stack">
    {panels.map((panel, i) => {
      const newest = getForNiche(panel.key);
      return (
        <div class="niche-wipe-panel" style={`z-index: ${i};`} data-niche-panel={panel.key}>
            <div class="niche-bg" aria-hidden="true">
              {newest?.data.loop ? (
                <video
                  muted
                  playsinline
                  loop
                  autoplay
                  preload="auto"
                >
                  <source src={newest.data.loop.replace(/\.mp4$/, '.webm')} type="video/webm" />
                  <source src={newest.data.loop} type="video/mp4" />
                </video>
              ) : newest ? (
                <img src={newest.data.thumb} alt="" />
              ) : null}
              <div class="niche-overlay"></div>
            </div>
            <div class="container niche-content-container">
              <div class="niche-content">
                <h2 class="niche-super-title">{panel.title}</h2>
                <ul class="niche-points">
                  {panel.points.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>
                {newest ? (
                  <button
                    class="niche-link"
                    data-niche-link={panel.key}
                    type="button"
                  >
                    See a {panel.key.toLowerCase()} ad
                  </button>
                ) : (
                  <div class="niche-coming-soon">{panel.key} ad coming soon</div>
                )}
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  #niches-pin-container {
    position: relative;
    height: 100vh;
    width: 100%;
    overflow: hidden;
  }
  .niches-stack {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100vh;
  }
  .niche-wipe-panel {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100vh;
    will-change: transform;
    display: flex;
    align-items: center;
  }
  .niche-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .niche-bg img,
  .niche-bg video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.4;
  }
  .niche-overlay {
    position: absolute;
    inset: 0;
    background: var(--ink);
    opacity: 0.4;
  }

  .niche-content-container {
    position: relative;
    z-index: 1;
    width: 100%;
  }

  .niche-content {
    max-width: 600px;
  }

  .niche-super-title { 
    font-size: clamp(3rem, 6vw, 5rem);
    font-weight: 800;
    font-family: var(--font-display);
    letter-spacing: -0.02em;
    margin-bottom: var(--sp-4);
    color: var(--chalk);
    line-height: 1.1;
  }

  .niche-points {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    margin-bottom: var(--sp-3);
  }
  .niche-points li {
    position: relative;
    padding-left: var(--sp-2);
    font-size: var(--text-body);
    color: var(--smoke);
  }
  .niche-points li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 8px;
    height: 2px;
    background: var(--rec);
  }

  .niche-link, .niche-coming-soon {
    background: none;
    border: none;
    padding: 0;
    color: var(--chalk);
    font-weight: 600;
    font-size: var(--text-button);
    text-decoration: underline;
    text-underline-offset: 3px;
    min-height: 44px;
    display: inline-block;
  }
  .niche-coming-soon {
    color: var(--smoke);
    font-size: var(--text-button);
    font-weight: 500;
    min-height: 44px;
    display: inline-block;
  }
</style>

<script>


  document.querySelectorAll<HTMLButtonElement>('[data-niche-link]').forEach((link) => {
    link.addEventListener('click', () => {
      const niche = link.dataset.nicheLink;
      const card = document.querySelector<HTMLElement>(`[data-niche="${niche}"]`);
      const target = card ?? document.getElementById('work');
      target?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      if (card) {
        card.classList.add('highlight');
        setTimeout(() => card.classList.remove('highlight'), 1600);
      }
    });
  });
</script>

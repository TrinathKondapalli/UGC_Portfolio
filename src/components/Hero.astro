---

import type { CollectionEntry } from 'astro:content';

interface Props {
  featured: CollectionEntry<'work'>[];
}

const { featured } = Astro.props;
const lines = ["AI UGC ads for", "Indian D2C brands"];
---
<section class="hero" id="hero">
  <div class="hero-inner container">
    <div class="hero-copy">
      <h1 class="hero-headline">
        {lines.map((line) => (
          <span class="hero-line-mask">
            <span class="hero-line">{line}</span>
          </span>
        ))}
      </h1>
      <p class="lead hero-lead">
        Send us your product. We research it, write the script, and produce a short vertical ad
        with Aanya, our AI creator. You get a ready-to-post ad plus alternative opening hooks to
        test.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" id="hero-cta" href="#sample">
          Book Demo
        </a>
        <a class="btn btn-ghost" href="#work">See the work</a>
      </div>
      <p class="caption hero-note">
        Beauty, fashion and fitness products. Every ad is labelled AI-generated.
      </p>
    </div>

    <div class="hero-fan" id="hero-fan">
      {featured.map((item, i) => (
        <div class={`phone-frame phone-${i}`} data-phone data-base-scale={i === 1 ? 1.05 : 1}>
          <div class="phone-screen">
            {item.data.loop ? (
              <video
                muted
                playsinline
                loop
                preload="none"
                poster={item.data.thumb}
                data-hero-video
              >
                <source src={item.data.loop.replace(/\.mp4$/, '.webm')} type="video/webm" />
                <source src={item.data.loop} type="video/mp4" />
              </video>
            ) : (
              <img src={item.data.thumb} alt={`${item.data.title} ad still`} />
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: calc(72px + var(--sp-3));
    padding-bottom: var(--sp-7);
    overflow: hidden;
  }
  @media (min-width: 900px) {
    .hero {
      padding-top: calc(var(--sp-4) + 64px + var(--sp-3));
    }
  }
  .hero-inner {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--sp-6);
  }
  @media (min-width: 900px) {
    .hero-inner {
      flex-direction: row;
      align-items: center;
      gap: var(--sp-5);
    }
  }

  .hero-copy { flex: 1 1 50%; max-width: 640px; }

  .hero-headline {
    font-size: var(--text-hero);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.025em;
    text-wrap: balance;
    max-width: 12ch;
  }
  .hero-line-mask {
    display: block;
    overflow: hidden;
  }
  .hero-line {
    display: block;
    will-change: transform;
  }

  .hero-lead {
    margin-top: var(--sp-3);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin-top: var(--sp-4);
  }

  .hero-note {
    margin-top: var(--sp-3);
  }

  .hero-fan {
    flex: 1 1 50%;
    width: 100%;
    min-height: 320px;
    padding-block: var(--sp-4);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  @media (min-width: 900px) {
    .hero-fan { min-height: 440px; }
  }

  .phone-frame {
    position: relative;
    flex: 0 0 auto;
    width: 150px;
    aspect-ratio: 9 / 16;
    background: var(--graphite);
    border-radius: var(--radius-phone);
    padding: 6px;
    box-shadow: 0 30px 60px -20px rgba(0,0,0,0.6);
  }
  @media (min-width: 560px) {
    .phone-frame { width: 230px; }
  }

  .phone-screen {
    width: 100%;
    height: 100%;
    border-radius: calc(var(--radius-phone) - 6px);
    overflow: hidden;
    background: var(--ink);
  }
  .phone-screen img,
  .phone-screen video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .phone-0 { transform: rotate(-9deg); z-index: 1; margin-right: -24px; }
  .phone-1 { transform: rotate(0deg) scale(1.05); z-index: 2; }
  .phone-2 { transform: rotate(9deg); z-index: 1; margin-left: -24px; }
  @media (min-width: 560px) {
    .phone-0 { margin-right: -48px; }
    .phone-2 { margin-left: -48px; }
  }
</style>

---
import { whatsappUrl } from '../config';
import type { CollectionEntry } from 'astro:content';

interface Props {
  featured: CollectionEntry<'work'>[];
}

const { featured } = Astro.props;
const lines = ["AI UGC ads for", "Indian D2C brands"];
---
<section class="hero" id="hero">
  <div class="hero-inner container">
    <div class="hero-copy">
      <h1 class="hero-headline">
        {lines.map((line) => (
          <span class="hero-line-mask">
            <span class="hero-line">{line}</span>
          </span>
        ))}
      </h1>
      <p class="lead hero-lead">
        Send us your product. We research it, write the script, and produce a short vertical ad
        with Aanya, our AI creator. You get a ready-to-post ad plus alternative opening hooks to
        test.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" id="hero-cta" href={whatsappUrl()} target="_blank" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12.04 2c-5.5 0-9.96 4.46-9.96 9.96 0 1.76.46 3.48 1.33 5L2 22l5.2-1.36a9.94 9.94 0 0 0 4.84 1.24h.01c5.5 0 9.96-4.46 9.96-9.96S17.54 2 12.04 2Zm0 18.2a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.1.81.83-3.02-.2-.31a8.23 8.23 0 0 1-1.26-4.39c0-4.55 3.7-8.25 8.25-8.25 2.2 0 4.27.86 5.83 2.42a8.2 8.2 0 0 1 2.41 5.83c0 4.55-3.7 8.24-8.27 8.24Zm4.52-6.16c-.25-.12-1.47-.72-1.7-.81-.23-.08-.4-.12-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.04-.38-1.99-1.22-.73-.66-1.23-1.46-1.37-1.71-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.16-.25.25-.41.08-.17.04-.31-.02-.44-.06-.12-.56-1.36-.77-1.86-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.87.86-.87 2.09 0 1.23.9 2.42 1.02 2.59.12.17 1.76 2.7 4.27 3.78.6.26 1.06.41 1.43.53.6.19 1.14.16 1.57.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.1-.23-.16-.48-.29Z"/>
          </svg>
          Get a free sample ad
        </a>
        <a class="btn btn-ghost" href="#work">See the work</a>
      </div>
      <p class="caption hero-note">
        Beauty, fashion and fitness products. Every ad is labelled AI-generated.
      </p>
    </div>

    <div class="hero-fan" id="hero-fan">
      {featured.map((item, i) => (
        <div class={`phone-frame phone-${i}`} data-phone>
          <div class="phone-screen">
            {item.data.loop ? (
              <video
                muted
                playsinline
                loop
                preload="none"
                poster={item.data.thumb}
                data-hero-video
              >
                <source src={item.data.loop.replace(/\.mp4$/, '.webm')} type="video/webm" />
                <source src={item.data.loop} type="video/mp4" />
              </video>
            ) : (
              <img src={item.data.thumb} alt={`${item.data.title} ad still`} />
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: var(--sp-6);
    padding-bottom: var(--sp-7);
    overflow: hidden;
  }
  .hero-inner {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--sp-6);
  }
  @media (min-width: 900px) {
    .hero-inner {
      flex-direction: row;
      align-items: center;
      gap: var(--sp-5);
    }
  }

  .hero-copy { flex: 1 1 50%; max-width: 640px; }

  .hero-headline {
    font-size: var(--text-hero);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.025em;
  }
  .hero-line-mask {
    display: block;
    overflow: hidden;
  }
  .hero-line {
    display: block;
    will-change: transform;
  }

  .hero-lead {
    margin-top: var(--sp-3);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin-top: var(--sp-4);
  }

  .hero-note {
    margin-top: var(--sp-3);
  }

  .hero-fan {
    position: relative;
    flex: 1 1 50%;
    height: 380px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  @media (min-width: 900px) {
    .hero-fan { height: 520px; }
  }

  .phone-frame {
    position: absolute;
    width: 200px;
    aspect-ratio: 9 / 16;
    background: var(--graphite);
    border-radius: var(--radius-phone);
    padding: 6px;
    box-shadow: 0 30px 60px -20px rgba(0,0,0,0.6);
  }
  @media (min-width: 560px) {
    .phone-frame { width: 230px; }
  }

  .phone-screen {
    width: 100%;
    height: 100%;
    border-radius: calc(var(--radius-phone) - 6px);
    overflow: hidden;
    background: var(--ink);
  }
  .phone-screen img,
  .phone-screen video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .phone-0 { transform: rotate(-9deg); z-index: 1; left: 8%; }
  .phone-1 { transform: rotate(0deg) scale(1.05); z-index: 2; left: 50%; margin-left: -115px; }
  .phone-2 { transform: rotate(9deg); z-index: 1; right: 8%; }
  @media (max-width: 559px) {
    .phone-1 { margin-left: -100px; }
  }
</style>

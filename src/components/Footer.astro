---
import { config, instagramUrl, whatsappUrl, emailUrl } from '../config';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-inner">
    <p class="caption footer-copy">
      &copy; {year} Tzinr. AI-generated creator. Concept ads are not sponsored by or affiliated
      with the brands shown.
    </p>
    <ul class="footer-links">
      <li><a href={instagramUrl} target="_blank" rel="noopener">Instagram</a></li>
      <li><a href={whatsappUrl()} target="_blank" rel="noopener">WhatsApp</a></li>
      <li><a href={emailUrl}>Email</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding-block: var(--sp-5);
  }
  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }
  @media (min-width: 900px) {
    .footer-inner {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }
  .footer-copy { max-width: 56ch; }
  .footer-links {
    display: flex;
    gap: var(--sp-3);
  }
  .footer-links a {
    text-decoration: none;
    font-size: var(--text-caption);
    font-weight: 500;
    color: var(--smoke);
  }
  .footer-links a:hover { color: var(--chalk); }
</style>

---
const steps = [
  {
    title: 'Send your product',
    body: 'Share the product name or link on WhatsApp.',
  },
  {
    title: 'We plan the ad',
    body: 'Product check, a single core idea, the hook, and a shot-by-shot script.',
  },
  {
    title: 'We produce it',
    body: 'AI video with Aanya, edited with captions, music and sound for vertical feeds.',
  },
  {
    title: 'You get the files',
    body: 'A ready-to-post 9:16 ad plus alternative hooks for testing.',
  },
];
---
<section class="how" id="how">
  <div class="container">
    <div class="section-head">
      <h2 class="heading">How it works</h2>
      <p class="sub">One product, one clear idea, one ad that leads with the product.</p>
    </div>

    <div class="steps-stack" id="steps-stack">
      {steps.map((step, i) => (
        <div class="step-card" style={`top: calc(15vh + ${i * 60}px); z-index: ${i};`}>
          <div class="step-card-inner">
            <span class="step-number">0{i + 1}</span>
            <div class="step-content">
              <h3 class="step-title">{step.title}</h3>
              <p class="step-body">{step.body}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .how {
    background: var(--chalk);
    color: var(--ink);
    border-radius: var(--radius-band);
  }

  .how .heading, .step-title { color: var(--ink); }
  .how .sub { color: var(--smoke); }

  .steps-stack {
    display: flex;
    flex-direction: column;
    gap: 40vh;
    padding-bottom: 20vh;
    margin-top: var(--sp-6);
  }

  .step-card {
    position: sticky;
    width: 100%;
    transform-origin: top center;
    will-change: transform;
  }

  .step-card-inner {
    background: var(--ink);
    border-radius: var(--radius-poster);
    padding: var(--sp-5);
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    box-shadow: 0 20px 40px rgba(0,0,0,0.1);
    color: var(--chalk);
    min-height: 300px;
    justify-content: center;
    border: 1px solid var(--line);
  }
  @media (min-width: 900px) {
    .step-card-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding: var(--sp-6) var(--sp-7);
    }
  }

  .step-number {
    font-family: var(--font-display);
    font-size: clamp(4rem, 10vw, 8rem);
    font-weight: 800;
    color: var(--smoke);
    line-height: 1;
    opacity: 0.2;
  }

  .step-content {
    flex: 1;
    max-width: 500px;
  }
  @media (min-width: 900px) {
    .step-content { margin-left: var(--sp-7); }
  }

  .step-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-bottom: var(--sp-3);
    color: var(--chalk);
  }

  .step-body {
    color: rgba(242, 240, 234, 0.7);
    font-size: var(--text-card);
    line-height: 1.5;
  }
</style>

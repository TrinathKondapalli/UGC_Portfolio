---
const steps = [
  {
    title: 'Send your product',
    body: 'Share the product name or link on WhatsApp.',
  },
  {
    title: 'We plan the ad',
    body: 'Product check, a single core idea, the hook, and a shot-by-shot script.',
  },
  {
    title: 'We produce it',
    body: 'AI video with Aanya, edited with captions, music and sound for vertical feeds.',
  },
  {
    title: 'You get the files',
    body: 'A ready-to-post 9:16 ad plus alternative hooks for testing.',
  },
];
---
<section class="how" id="how">
  <div class="container">
    <div class="section-head">
      <h2 class="heading">How it works</h2>
      <p class="sub">One product, one clear idea, one ad that leads with the product.</p>
    </div>

    <div class="steps" id="steps-track">
      <div class="steps-line-rail" aria-hidden="true">
        <div class="steps-line-fill" id="steps-line-fill"></div>
      </div>
      {steps.map((step, i) => (
        <div class="step">
          <span class="step-number" data-step-number>{i + 1}</span>
          <h3 class="step-title">{step.title}</h3>
          <p class="step-body">{step.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .how {
    background: var(--chalk);
    color: var(--ink);
    border-radius: var(--radius-band);
  }

  .how .heading, .step-title { color: var(--ink); }
  .how .sub { color: var(--smoke); }

  .steps {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-6);
  }
  @media (min-width: 900px) {
    .steps {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--sp-4);
    }
  }

  .steps-line-rail {
    position: absolute;
    background: rgba(0, 0, 0, 0.1);
    top: 22px;
    left: 22px;
    width: 2px;
    height: calc(100% - 44px);
  }
  @media (min-width: 900px) {
    .steps-line-rail {
      top: 22px;
      left: calc(12.5% + 0px);
      right: calc(12.5% + 0px);
      width: auto;
      height: 2px;
    }
  }

  .steps-line-fill {
    position: absolute;
    left: 0;
    top: 0;
    background: var(--ink);
    width: 100%;
    height: 100%;
    transform-origin: top left;
  }
  @media (min-width: 900px) {
    .steps-line-fill { transform-origin: left top; }
  }

  .step {
    position: relative;
    padding-left: var(--sp-6);
  }
  @media (min-width: 900px) {
    .step { padding-left: 0; }
  }

  .step-number {
    position: absolute;
    left: 0;
    top: -4px;
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--smoke);
    line-height: 1;
  }
  @media (min-width: 900px) {
    .step-number {
      position: static;
      display: block;
      margin-bottom: var(--sp-3);
    }
  }

  .step-title {
    font-size: var(--text-card);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin-bottom: var(--sp-1);
  }

  .step-body {
    color: var(--ink);
    font-size: var(--text-body);
    line-height: 1.6;
    max-width: 32ch;
  }
</style>
